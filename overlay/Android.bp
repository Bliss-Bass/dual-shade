package {
    default_applicable_licenses: ["vendor_dual-shade_license"],
}

// Static SystemUI config for Dual Shade on large screens: on by default, desktop status bar,
// notifications on the end side, Quick Settings volume slider. Always on.
runtime_resource_overlay {
    name: "DualShadeSystemUI",
    resource_dirs: ["res"],
    manifest: "AndroidManifest.xml",
    // Installed to /product/overlay. Overlays on /product may replace resources of targets
    // that declare no <overlayable>, which is the case for SystemUI.
    product_specific: true,
}
