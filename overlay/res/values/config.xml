<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Separate Notifications and Quick Settings panels until the user picks a layout on the
         Shade panels page in Settings (patch 0005). -->
    <bool name="config_dualShadeEnabledByDefault">true</bool>
    <!-- Notifications open on the right, next to Quick Settings. -->
    <bool name="config_notificationShadeOnTopEnd">true</bool>
    <!-- Desktop status bar: clock left, notification and Quick Settings chips right. -->
    <bool name="config_useDesktopStatusBar">true</bool>
    <!-- Volume slider in the Quick Settings panel (the volume dialog stays hidden while it shows;
         patch 0003). -->
    <bool name="config_enableDesktopAudioTileDetailsView">true</bool>
    <!-- Android 17 hides the Notifications & Quick Settings layout choice on sw600dp and up
         and ignores the dual_shade setting there; let users pick (see overlay-settings/). -->
    <bool name="config_useDualShadeSetting">true</bool>
    <!-- WM Shell: keep the app handle's input layer over the status bar. With scene_container
         the status bar sends every downward drag to the shade, so without this layer the handle
         can no longer be dragged into freeform (Android 17 defaults this to true). -->
    <bool name="config_removeStatusBarInputLayer">false</bool>
</resources>
