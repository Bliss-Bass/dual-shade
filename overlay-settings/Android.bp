package {
    default_applicable_licenses: ["vendor_dual-shade_license"],
}

// Shows the Notifications & Quick Settings layout choice (Settings > Notifications) on large
// screens, where Android 17's SettingsLib hides it. Pairs with the same value in
// DualShadeSystemUI, which makes SystemUI honor the choice.
runtime_resource_overlay {
    name: "DualShadeSettings",
    resource_dirs: ["res"],
    manifest: "AndroidManifest.xml",
    product_specific: true,
}
