From bd0438662ea4e9a3881d1f1f7f0256d28c3c7e1e Mon Sep 17 00:00:00 2001
From: Jon West <electrikjesus@gmail.com>
Date: Thu, 5 Nov 2026 13:02:17 -0500
Subject: [PATCH 5/5] SystemUI: Let a config overlay turn Dual Shade on by
 default

While Settings.Secure.DUAL_SHADE is unset, SystemUI used the single or
split shade but Settings showed "Separate panels" as selected. Read the
default from config_dualShadeEnabledByDefault (false, as before) so a
device overlay can make Dual Shade the default and both agree, without
writing the setting at boot.
---
 packages/SystemUI/res/values/config.xml                |  6 ++++++
 .../shade/data/repository/ShadeConfigRepository.kt     |  4 ++++
 .../shade/domain/interactor/ShadeModeInteractor.kt     | 10 +++++-----
 3 files changed, 15 insertions(+), 5 deletions(-)

diff --git a/packages/SystemUI/res/values/config.xml b/packages/SystemUI/res/values/config.xml
index e0bc1ec0e01a..f261f566845a 100644
--- a/packages/SystemUI/res/values/config.xml
+++ b/packages/SystemUI/res/values/config.xml
@@ -694,6 +694,12 @@
     <!-- TODO(b/411449027): Remove this config once it is true on all configurations. -->
     <bool name="config_disableSplitShade">false</bool>
 
+    <!-- Whether the shade uses Dual Shade (separate Notifications and Quick Settings panels)
+         until the user picks a layout in Settings, that is while Settings.Secure.DUAL_SHADE is
+         unset. Settings shows the separate panels as selected in that case, so devices that want
+         them should set this to true. Only has an effect with the scene container. -->
+    <bool name="config_dualShadeEnabledByDefault">false</bool>
+
     <!-- Whether we use large screen shade header which takes only one row compared to QS header -->
     <bool name="config_use_large_screen_shade_header">false</bool>
 
diff --git a/packages/SystemUI/src/com/android/systemui/shade/data/repository/ShadeConfigRepository.kt b/packages/SystemUI/src/com/android/systemui/shade/data/repository/ShadeConfigRepository.kt
index 0b53746cdae3..1356b6fbd549 100644
--- a/packages/SystemUI/src/com/android/systemui/shade/data/repository/ShadeConfigRepository.kt
+++ b/packages/SystemUI/src/com/android/systemui/shade/data/repository/ShadeConfigRepository.kt
@@ -46,6 +46,10 @@ constructor(
     val isSplitShadeDisabled: Boolean =
         SceneContainerFlag.isEnabled && resources.getBoolean(R.bool.config_disableSplitShade)
 
+    /** Whether Dual Shade is on while the user hasn't picked a layout (DUAL_SHADE unset). */
+    val isDualShadeEnabledByDefault: Boolean =
+        resources.getBoolean(R.bool.config_dualShadeEnabledByDefault)
+
     /** @see isFullWidthShade (the `val` above) */
     fun isFullWidthShade(): Boolean = resources.getBoolean(R.bool.config_isFullWidthShade)
 
diff --git a/packages/SystemUI/src/com/android/systemui/shade/domain/interactor/ShadeModeInteractor.kt b/packages/SystemUI/src/com/android/systemui/shade/domain/interactor/ShadeModeInteractor.kt
index e299a553812c..0c34a1a4c310 100644
--- a/packages/SystemUI/src/com/android/systemui/shade/domain/interactor/ShadeModeInteractor.kt
+++ b/packages/SystemUI/src/com/android/systemui/shade/domain/interactor/ShadeModeInteractor.kt
@@ -87,7 +87,10 @@ constructor(
     private val isDualShadeSettingEnabled: Flow<Boolean> =
         if (SceneContainerFlag.isEnabled) {
             secureSettingsRepository
-                .boolSetting(Settings.Secure.DUAL_SHADE, defaultValue = DUAL_SHADE_ENABLED_DEFAULT)
+                .boolSetting(
+                    Settings.Secure.DUAL_SHADE,
+                    defaultValue = shadeConfigRepository.isDualShadeEnabledByDefault,
+                )
                 .flowOn(backgroundDispatcher)
         } else {
             flowOf(false)
@@ -120,7 +123,7 @@ constructor(
     private val shadeModeInitialValue: ShadeMode
         get() =
             determineShadeMode(
-                isDualShadeSettingEnabled = DUAL_SHADE_ENABLED_DEFAULT,
+                isDualShadeSettingEnabled = shadeConfigRepository.isDualShadeEnabledByDefault,
                 isFullWidthShade = isFullWidthShade.value,
             )
 
@@ -158,9 +161,6 @@ constructor(
 
     companion object {
         private const val TAG = "ShadeModeInteractorImpl"
-
-        /* Whether the Dual Shade setting is enabled by default. */
-        private const val DUAL_SHADE_ENABLED_DEFAULT = false
     }
 }
 
